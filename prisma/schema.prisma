// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  bio           String?
  skills        String? // JSON string of skills array
  latitude      Float?
  longitude     Float?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tasksOffered  Task[]   @relation("TaskProvider")
  tasksRequested Task[]  @relation("TaskRequester")
  reviewsGiven  Review[] @relation("ReviewGiver")
  reviewsReceived Review[] @relation("ReviewReceiver")

  // Reputation
  totalRating   Float    @default(0)
  reviewCount   Int      @default(0)
  completedTasks Int     @default(0)

  // Matching data
  matchHistory  MatchHistory[]
}

model Task {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String   // e.g., "groceries", "dog-walking", "errands"
  status        String   @default("open") // open, assigned, in-progress, completed, cancelled

  // Pricing
  price         Float
  currency      String   @default("USD")
  paymentStatus String   @default("pending") // pending, paid, refunded
  stripePaymentIntentId String?

  // Location
  latitude      Float
  longitude     Float
  address       String
  radius        Float?   // Task radius in km

  // Scheduling
  scheduledAt   DateTime?
  completedAt   DateTime?
  deadline      DateTime?

  // Relations
  providerId    String?
  provider      User?    @relation("TaskProvider", fields: [providerId], references: [id])
  requesterId   String
  requester     User     @relation("TaskRequester", fields: [requesterId], references: [id])
  review        Review?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id            String   @id @default(cuid())
  rating        Int      // 1-5
  comment       String?

  // Relations
  taskId        String   @unique
  task          Task     @relation(fields: [taskId], references: [id])
  giverId       String
  giver         User     @relation("ReviewGiver", fields: [giverId], references: [id])
  receiverId    String
  receiver      User     @relation("ReviewReceiver", fields: [receiverId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MatchHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  taskId        String
  matchScore    Float    // ML-generated match score
  wasAccepted   Boolean  @default(false)

  createdAt     DateTime @default(now())
}
